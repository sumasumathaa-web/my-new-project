# =============================================================================
# Wedding Invitation Platform — Environment Variables (TEMPLATE)
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# ---------- Supabase (database, auth, storage) ----------
# From: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres URI (used by scripts, backups)
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ---------- Razorpay (payments) ----------
# From: https://dashboard.razorpay.com/app/keys  (use TEST keys while developing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Set PAYMENTS_TEST_MODE=false when live keys are configured.
PAYMENTS_TEST_MODE=true

# ---------- App ----------
# Public URL of the deployed site (used for sitemap, canonical URLs, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated emails that are allowed to be promoted to admin via the
# scripts/grant-admin.mjs helper (defence-in-depth; promotion is manual).
ADMIN_SETUP_EMAILS=you@example.com

# ---------- Transactional email (optional) ----------
# If unset, the app records emails in the audit log instead of sending.
# EMAIL_PROVIDER=log            <- default, nothing leaves the server
# EMAIL_PROVIDER=resend         + RESEND_API_KEY
# EMAIL_PROVIDER=postmark       + POSTMARK_SERVER_TOKEN
# EMAIL_PROVIDER=sendgrid       + SENDGRID_API_KEY
# EMAIL_PROVIDER=smtp           + SMTP_URL=smtp://user:pass@host:587 (or EMAIL_API_KEY)
EMAIL_PROVIDER=log
EMAIL_API_KEY=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
SMTP_URL=
EMAIL_FROM="Your Brand Name <no-reply@yourbrand.example>"

# ---------- Local embedded database (development only) ----------
# With no Supabase credentials above, the app runs a real embedded PostgreSQL
# (PGlite) using supabase/migrations + supabase/seed.sql. Never used on Vercel.
# LOCAL_DB=1                       # force-enable (default: auto when Supabase is absent)
# LOCAL_DB_DIR=.data/pglite        # database directory
# LOCAL_DEMO_PASSWORD=Password123! # password for the seeded local demo accounts
# LOCAL_MEDIA_SECRET=change-me     # HMAC secret for local signed media URLs
# LOCAL_DB_DEBUG=1                 # log query errors from the embedded engine

# ---------- Storage bucket names (must match supabase/migrations) ----------
STORAGE_BUCKET_PUBLIC=public-media
STORAGE_BUCKET_CUSTOMER=customer-uploads
STORAGE_BUCKET_DELIVERABLES=deliverables
